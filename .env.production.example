# Contoh .env untuk server produksi.
# Salin ke .env DI SERVER (jangan commit .env asli), lalu isi nilainya.

APP_NAME="Parc Fermé"
APP_ENV=production
# Isi lewat: php artisan key:generate
APP_KEY=
# WAJIB false: kalau true, pengunjung bisa melihat kode dan isi konfigurasi saat terjadi error
APP_DEBUG=false
APP_URL=https://domain-kamu.example

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parc_ferme
# Jangan pakai root: buat user khusus aplikasi dengan password kuat
DB_USERNAME=
DB_PASSWORD=

# Sesi dan cache tidak bergantung pada database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookie sesi hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

SHOW_CAR_IMAGES=false
SCRAPER_CONTACT=emailkamu@example.com
USD_TO_IDR=16000
